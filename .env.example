# Copy this file to .env and fill in one or more backend API keys.
# DeepSeek is the default backend.

CHEAPCLAUDE_DEFAULT_BACKEND=ds

DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
FIREWORKS_API_KEY=

# Optional: set to "off" to disable Anthropic image fallback through the proxy.
DEEPCLAUDE_IMAGE_FALLBACK=anthropic
