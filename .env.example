# Copy to .env and fill in the providers you use.
# .env is gitignored; keep real keys out of commits.

DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
FIREWORKS_API_KEY=

# Default backend: ds, or, fw, anthropic
CHEAPCLAUDE_DEFAULT_BACKEND=ds

# Image fallback provider: anthropic, ds, or, fw
DEEPCLAUDE_IMAGE_FALLBACK=anthropic
